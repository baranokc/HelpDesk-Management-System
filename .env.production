# Production Environment Configuration
# IMPORTANT: Update all values before deployment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
POSTGRES_DB=HelpDeskDb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
JWT_SECRET=GENERATE_SECURE_JWT_SECRET_HERE_MIN_32_CHARS
JWT_ISSUER=HelpDeskApi
JWT_AUDIENCE=HelpDeskClient

NODE_ENV=production
NEXT_PUBLIC_API_URL=https://helpdesk.example.com/api

COMPOSE_PROJECT_NAME=helpdesk-production
REGISTRY=ghcr.io/your-org
TAG=latest
