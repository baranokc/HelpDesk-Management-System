# Staging Environment Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging-password-change-me
POSTGRES_DB=HelpDeskDb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://+:8080
JWT_SECRET=staging-secret-key-change-me-to-secure-value
JWT_ISSUER=HelpDeskApi
JWT_AUDIENCE=HelpDeskClient

NODE_ENV=production
NEXT_PUBLIC_API_URL=https://staging.helpdesk.example.com/api

COMPOSE_PROJECT_NAME=helpdesk-staging
REGISTRY=ghcr.io/your-org
TAG=staging
